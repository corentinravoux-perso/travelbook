{
  "name": "@travelbook/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app for composing printed travel photo albums.",
  "author": "Corentin Ravoux",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "icons": "node scripts/generate-icons.ts",
    "backgrounds": "node scripts/build-backgrounds.ts",
    "templates": "node scripts/build-templates.ts && vitest run scripts/build-templates.test.ts",
    "e2e": "electron-vite build --mode e2e && playwright test",
    "dist:linux": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@iconify-json/tabler": "1.2.43",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "jsdom": "31.0.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@travelbook/core": "0.0.0",
    "@travelbook/render": "0.0.0",
    "exifr": "7.1.3",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
