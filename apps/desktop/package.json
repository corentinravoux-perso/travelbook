{
  "name": "@travelbook/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app for composing printed travel photo albums.",
  "author": "Corentin Ravoux",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run stickers && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "icons": "node scripts/generate-icons.ts",
    "backgrounds": "node scripts/build-backgrounds.ts",
    "templates": "node scripts/build-templates.ts && vitest run scripts/build-templates.test.ts",
    "e2e": "npm run stickers && electron-vite build --mode e2e && playwright test",
    "dist:linux": "npm run build && electron-builder --linux deb",
    "dist:win": "npm run build && electron-builder --win nsis",
    "stickers": "node scripts/build-sticker-packs.ts"
  },
  "devDependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/oswald": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@iconify-json/carbon": "1.2.30",
    "@iconify-json/circle-flags": "1.2.14",
    "@iconify-json/fa6-solid": "1.2.4",
    "@iconify-json/flag": "1.2.15",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@iconify-json/gis": "1.2.6",
    "@iconify-json/iconoir": "1.2.12",
    "@iconify-json/ion": "1.2.7",
    "@iconify-json/maki": "1.2.6",
    "@iconify-json/mdi": "1.2.3",
    "@iconify-json/meteocons": "1.2.5",
    "@iconify-json/mingcute": "1.2.10",
    "@iconify-json/noto": "1.2.10",
    "@iconify-json/openmoji": "1.2.31",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/streamline-emojis": "1.2.4",
    "@iconify-json/streamline-freehand-color": "1.2.2",
    "@iconify-json/streamline-kameleon-color": "1.2.3",
    "@iconify-json/streamline-plump-color": "1.2.2",
    "@iconify-json/streamline-stickies-color": "1.2.2",
    "@iconify-json/streamline-ultimate-color": "1.2.2",
    "@iconify-json/tabler": "1.2.43",
    "@iconify-json/twemoji": "1.2.5",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "emojibase-data": "18.0.0",
    "jsdom": "31.0.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-text-align": "3.34.0",
    "@tiptap/extension-text-style": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@travelbook/core": "0.0.0",
    "@travelbook/render": "0.0.0",
    "@xmldom/xmldom": "0.9.12",
    "exifr": "7.1.3",
    "minisearch": "7.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
