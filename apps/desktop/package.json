{
  "name": "@travelbook/desktop",
  "productName": "travelbook",
  "version": "1.3.2",
  "private": true,
  "description": "Desktop app for composing printed travel photo albums.",
  "author": "Corentin Ravoux",
  "homepage": "https://github.com/corentinravoux-perso/travelbook",
  "desktopName": "travelbook.desktop",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run stickers && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run --passWithNoTests",
    "icons": "node scripts/generate-icons.ts",
    "app-icons": "node scripts/build-app-icons.ts",
    "backgrounds": "node scripts/build-backgrounds.ts",
    "templates": "node scripts/build-templates.ts && vitest run scripts/build-templates.test.ts",
    "e2e": "npm run stickers && electron-vite build --mode e2e && playwright test",
    "e2e:packaged": "playwright test -c playwright.packaged.config.ts",
    "e2e:stress": "playwright test -c playwright.stress.config.ts",
    "dist:linux": "npm run build && electron-builder --linux deb --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "stickers": "node scripts/build-sticker-packs.ts",
    "draw-stickers": "node scripts/stickers/draw-stickers.ts",
    "fonts": "node scripts/build-fonts.ts",
    "maps": "node scripts/maps/build-geodata.ts"
  },
